{
  "_comment": "Not wired into the root manifest.json on purpose: these Flights need a Postgres you own and a `pg` Flight secret that only exists in your org. Paste these two entries into your fork's manifest.json flights[] once the secret exists. Create the transform first, then put its flight_id into TRIGGER_FLIGHT_ID.",
  "flights": [
    {
      "name": "pg-dlt-transform",
      "source": "flights/pg-dlt-sync/transform/flight.py",
      "requirements": "flights/pg-dlt-sync/transform/requirements.txt",
      "instance_type": "F16",
      "run_on_deploy": false,
      "config": {
        "CURATED_SCHEMA": "curated",
        "TARGET_DB": "",
        "RAW_SCHEMA": "",
        "INCREMENTAL_TABLES": ""
      }
    },
    {
      "name": "pg-dlt-ingest",
      "source": "flights/pg-dlt-sync/ingest/flight.py",
      "requirements": "flights/pg-dlt-sync/ingest/requirements.txt",
      "schedule_cron": "*/15 * * * *",
      "run_on_deploy": false,
      "secrets": ["pg"],
      "config": {
        "SOURCE_SCHEMA": "public",
        "TABLES": "customers,orders",
        "INCREMENTAL_TABLES": "orders:updated_at:id",
        "INCREMENTAL_MODE": "append",
        "TARGET_DB": "pg_sync",
        "TARGET_SCHEMA": "raw",
        "TRIGGER_FLIGHT_ID": "<flight_id of pg-dlt-transform>",
        "DLT_BACKEND": "sqlalchemy"
      }
    }
  ]
}
